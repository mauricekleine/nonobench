{
	"$schema": "node_modules/wrangler/config-schema.json",
	// nonobench.com as a TanStack Start Worker with static assets.
	// The top level is production. It has no routes until the cutover, so a
	// plain `wrangler deploy` cannot take traffic from the current host.
	"name": "nonobench",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./app/server.ts",
	"assets": {
		"binding": "ASSETS",
		// The Worker sees every request: it adds the agent Link, CORS and
		// noindex headers, negotiates markdown and redirects the apex to www.
		"run_worker_first": true
	},
	"workers_dev": false,
	"observability": { "enabled": true },
	"env": {
		// Built with CLOUDFLARE_ENV=beta (bun run deploy:beta); deploys as the
		// separate Worker nonobench-beta on beta.nonobench.com only.
		"beta": {
			"routes": [{ "pattern": "beta.nonobench.com", "custom_domain": true }]
		}
	}
}
