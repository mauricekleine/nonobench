{
  "$schema": "node_modules/wrangler/config-schema.json",
  // nonobench.com as a TanStack Start Worker with static assets.
  // Workers Builds owns production deploys from main, using bunx wrangler
  // deploy with Cloudflare credentials. Local deploy scripts are retired. The
  // routes below sit on the zone's proxied apex and www DNS records; each
  // deploy sets the Worker's routes to exactly this list.
  "name": "nonobench",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./app/server.ts",
  "assets": {
    "binding": "ASSETS",
    // The Worker sees every request: it adds the agent Link, CORS and
    // noindex headers, negotiates markdown and redirects the apex to www.
    "run_worker_first": true,
  },
  "routes": [
    { "pattern": "nonobench.com/*", "zone_name": "nonobench.com" },
    { "pattern": "www.nonobench.com/*", "zone_name": "nonobench.com" },
  ],
  "workers_dev": false,
  "observability": { "enabled": true },
  "env": {
    // CLOUDFLARE_ENV=beta bun run build builds the separate nonobench-beta
    // Worker for local preview. No Workers Builds trigger deploys beta.
    "beta": {
      "routes": [{ "pattern": "beta.nonobench.com", "custom_domain": true }],
    },
  },
}
