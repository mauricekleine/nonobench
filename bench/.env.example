OPENROUTER_API_KEY=""

# Optional: a model that you serve yourself. Any OpenAI-compatible /v1 server
# works: vLLM, SGLang, llama.cpp, LM Studio, and Ollama.
# Set both NONOBENCH_LOCAL_BASE_URL and NONOBENCH_LOCAL_MODEL to add the model
# to the run plan. Then select it with --model <name>.
# NONOBENCH_LOCAL_BASE_URL=http://192.168.1.20:8000/v1
# NONOBENCH_LOCAL_MODEL=Qwen3-32B
# NONOBENCH_LOCAL_NAME=Qwen3-32B (local)
# NONOBENCH_LOCAL_API_KEY=
