OPENROUTER_API_KEY=""

# Optional: a model that you serve yourself. Any OpenAI-compatible /v1 server
# works: vLLM, SGLang, llama.cpp, LM Studio, and Ollama.
# Set both NONOBENCH_LOCAL_BASE_URL and NONOBENCH_LOCAL_MODEL to add the model
# to the run plan. Then select it with --model <name>.
# NONOBENCH_LOCAL_BASE_URL=http://192.168.1.20:8000/v1
# NONOBENCH_LOCAL_MODEL=Qwen3-32B
# NONOBENCH_LOCAL_NAME=Qwen3-32B (local)
# NONOBENCH_LOCAL_API_KEY=
# NONOBENCH_LOCAL_EFFORT=xhigh
#   The reasoning effort your server is configured with. Label only: the runner
#   sends no reasoning settings to a local server. Defaults to none.

# Keep your own runs out of the shared dataset. The export-contract test compares
# the committed JSON exports against bench/results.db, so a local run that writes
# there makes bun test fail. Give a local run its own database.
# NONOBENCH_DB=local-results.db
